<mxfile host="app.diagrams.net">
  <diagram id="tp3-etape4" name="Topologie étape 4">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="960" math="0" shadow="0">
      <root>
