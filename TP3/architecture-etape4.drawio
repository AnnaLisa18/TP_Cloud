        <mxCell id="f1" value="HTTP :50001" style="html=1;endArrow=block;strokeWidth=1.5;strokeColor=#1d63ed;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;" edge="1" parent="1" source="vmfront" target="vmsum">
