        <mxCell id="e1" value="HTTP POST :80&lt;br&gt;SSH :22" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pc" target="ext">
